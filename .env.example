
AUTH_DATABASE_URL=sqlite:///./auth.db

# JWT
JWT_SECRET_KEY=replace_with_your_existing_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_key

# Product service
PRODUCT_SERVICE_URL=http://product_service:8002