              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{customer_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration accepted or duplicate/validation handled',()=>pm.expect([200,201,400,409,422]).to.include(pm.response.code));",
                  "if ([200,201].includes(pm.response.code)) { const d=pm.response.json(); if (d.id !== undefined) pm.collectionVariables.set('user_id', d.id); }"
                ]
              }
            }
